DATABASE_URL=postgresql+psycopg://commuteos:commuteos@localhost:5432/commuteos
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Phase 3 LLM phrasing (optional - falls back to a template if unset)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# NJ Transit (optional - not yet implemented, pending developer approval)
NJT_USERNAME=
NJT_PASSWORD=

# Firebase service account credentials, as a single-line JSON string (the
# whole downloaded service account key file's contents) - optional, falls
# back to logging instead of sending a real push if unset. See
# app/notify_service.py.
FIREBASE_CREDENTIALS_JSON=

# Shared secret for POST /internal/run-commute-job, called by the
# scheduled GitHub Actions workflow (.github/workflows/commute-notifications.yml)
# rather than any per-user auth. Unset disables the endpoint (503).
INTERNAL_JOB_SECRET=
